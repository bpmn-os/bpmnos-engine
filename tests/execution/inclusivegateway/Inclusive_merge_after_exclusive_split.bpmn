<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bpmnos="https://bpmnos.telematique.eu" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_1" />
    <bpmn2:parallelGateway id="Gateway_1">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_A1</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_X1</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:sequenceFlow id="Flow_A1" sourceRef="Gateway_1" targetRef="Task_A" />
    <bpmn2:task id="Task_A">
      <bpmn2:incoming>Flow_A1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_A2</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_A2" sourceRef="Task_A" targetRef="Gateway_2" />
    <bpmn2:sequenceFlow id="Flow_X1" sourceRef="Gateway_1" targetRef="Task_X" />
    <bpmn2:task id="Task_X">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_X" expression="timestamp += 3" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_X1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_X2</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_X2" sourceRef="Task_X" targetRef="Gateway_X" />
    <bpmn2:exclusiveGateway id="Gateway_X">
      <bpmn2:incoming>Flow_X2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_X3</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_X4</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="Flow_X3" sourceRef="Gateway_X" targetRef="Gateway_2">
      <bpmn2:extensionElements>
        <bpmnos:restrictions>
          <bpmnos:restriction id="Condition_Flow_X3" expression="timestamp &#62;= 4" />
        </bpmnos:restrictions>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_X4" sourceRef="Gateway_X" targetRef="EndEvent_2">
      <bpmn2:extensionElements>
        <bpmnos:restrictions>
          <bpmnos:restriction id="Condition_Flow_X4" expression="timestamp &#60; 4" />
        </bpmnos:restrictions>
      </bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:endEvent id="EndEvent_2">
      <bpmn2:incoming>Flow_X4</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:inclusiveGateway id="Gateway_2">
      <bpmn2:incoming>Flow_A2</bpmn2:incoming>
      <bpmn2:incoming>Flow_X3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:inclusiveGateway>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Gateway_2" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
  </bpmn2:process>
</bpmn2:definitions>
