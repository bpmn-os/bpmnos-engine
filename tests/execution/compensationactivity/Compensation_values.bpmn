<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmnos="https://bpmnos.telematique.eu" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
          <bpmnos:attribute id="Level" type="integer" name="level := 0" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
          <bpmnos:attribute id="Stock" type="integer" name="stock := 0" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_1" />
    <bpmn2:task id="Activity_1">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_1" expression="level := 5" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:boundaryEvent id="CompensateBoundaryEvent_1" attachedToRef="Activity_1">
      <bpmn2:compensateEventDefinition id="CompensateEventDefinition_1" />
    </bpmn2:boundaryEvent>
    <bpmn2:task id="CompensationActivity_1" isForCompensation="true">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:attributes>
            <bpmnos:attribute id="SeenLevel" type="integer" name="seen_level := level" />
            <bpmnos:attribute id="SeenStock" type="integer" name="seen_stock := stock" />
            <bpmnos:attribute id="SeenTime" type="decimal" name="seen_time := timestamp" />
            <bpmnos:attribute id="Given" type="integer" name="given" />
            <bpmnos:attribute id="Sampled" type="integer" name="sampled" />
          </bpmnos:attributes>
        </bpmnos:status>
      </bpmn2:extensionElements>
    </bpmn2:task>
    <bpmn2:association id="Association_1" associationDirection="One" sourceRef="CompensateBoundaryEvent_1" targetRef="CompensationActivity_1" />
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Activity_1" targetRef="Activity_2" />
    <bpmn2:task id="Activity_2">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_2" expression="level := 9" />
            <bpmnos:operator id="Operator_3" expression="stock := 7" />
            <bpmnos:operator id="Operator_4" expression="timestamp += 10" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Activity_2" targetRef="CompensateThrowEvent_1" />
    <bpmn2:endEvent id="CompensateThrowEvent_1">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:compensateEventDefinition id="CompensateEventDefinition_2" />
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
