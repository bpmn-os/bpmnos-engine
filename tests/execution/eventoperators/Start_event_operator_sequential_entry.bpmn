<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmnos="https://bpmnos.telematique.eu" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
          <bpmnos:attribute id="Gain" type="integer" name="gain := 0" objective="maximize" weight="1" />
          <bpmnos:attribute id="Bonus" type="integer" name="bonus := 1" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="AdHocSubProcess_1" />
    <bpmn2:adHocSubProcess id="AdHocSubProcess_1" ordering="Sequential">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:subProcess id="SubProcess_A">
        <bpmn2:startEvent id="StartEvent_A">
          <bpmn2:extensionElements>
            <bpmnos:status>
              <bpmnos:operators>
                <bpmnos:operator id="Operator_A" expression="gain := gain + bonus" />
              </bpmnos:operators>
            </bpmnos:status>
          </bpmn2:extensionElements>
          <bpmn2:outgoing>Flow_A1</bpmn2:outgoing>
        </bpmn2:startEvent>
        <bpmn2:sequenceFlow id="Flow_A1" sourceRef="StartEvent_A" targetRef="EndEvent_A" />
        <bpmn2:endEvent id="EndEvent_A">
          <bpmn2:incoming>Flow_A1</bpmn2:incoming>
        </bpmn2:endEvent>
      </bpmn2:subProcess>
      <bpmn2:subProcess id="SubProcess_B">
        <bpmn2:startEvent id="StartEvent_B">
          <bpmn2:extensionElements>
            <bpmnos:status>
              <bpmnos:operators>
                <bpmnos:operator id="Operator_B" expression="gain := gain + 5" />
              </bpmnos:operators>
            </bpmnos:status>
          </bpmn2:extensionElements>
          <bpmn2:outgoing>Flow_B1</bpmn2:outgoing>
        </bpmn2:startEvent>
        <bpmn2:sequenceFlow id="Flow_B1" sourceRef="StartEvent_B" targetRef="EndEvent_B" />
        <bpmn2:endEvent id="EndEvent_B">
          <bpmn2:incoming>Flow_B1</bpmn2:incoming>
        </bpmn2:endEvent>
      </bpmn2:subProcess>
    </bpmn2:adHocSubProcess>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="AdHocSubProcess_1" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
