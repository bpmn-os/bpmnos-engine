<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmnos="https://bpmnos.telematique.eu" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
          <bpmnos:attribute id="Escalated" type="integer" name="escalated" />
          <bpmnos:attribute id="Cause" type="integer" name="cause" />
          <bpmnos:attribute id="EscalationHandled" type="integer" name="escalation_handled" />
          <bpmnos:attribute id="ErrorHandled" type="integer" name="error_handled" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_1" />
    <bpmn2:subProcess id="Activity_1">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:startEvent id="StartEvent_2">
        <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_2" sourceRef="StartEvent_2" targetRef="EscalationEvent_1" />
      <bpmn2:intermediateThrowEvent id="EscalationEvent_1">
        <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_1" expression="escalated := 1" />
          </bpmnos:operators>
        </bpmnos:status>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_2</bpmn2:incoming>
        <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
        <bpmn2:escalationEventDefinition id="EscalationEventDefinition_1" />
      </bpmn2:intermediateThrowEvent>
      <bpmn2:sequenceFlow id="Flow_3" sourceRef="EscalationEvent_1" targetRef="ErrorEndEvent_1" />
      <bpmn2:endEvent id="ErrorEndEvent_1">
        <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_2" expression="cause := 7" />
          </bpmnos:operators>
        </bpmnos:status>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_3</bpmn2:incoming>
        <bpmn2:errorEventDefinition id="ErrorEventDefinition_1" />
      </bpmn2:endEvent>
    </bpmn2:subProcess>
    <bpmn2:boundaryEvent id="ErrorBoundaryEvent_1" attachedToRef="Activity_1">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_3" expression="error_handled := 1" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorEventDefinition_2" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="ErrorBoundaryEvent_1" targetRef="EndEvent_1" />
    <bpmn2:endEvent id="EndEvent_1">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:boundaryEvent id="EscalationBoundaryEvent_1" cancelActivity="false" attachedToRef="Activity_1">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_4" expression="escalation_handled := 1" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
      <bpmn2:escalationEventDefinition id="EscalationEventDefinition_2" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="EscalationBoundaryEvent_1" targetRef="EndEvent_2" />
    <bpmn2:endEvent id="EndEvent_2">
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
  </bpmn2:process>
</bpmn2:definitions>
