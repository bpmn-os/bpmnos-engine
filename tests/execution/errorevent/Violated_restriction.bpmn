<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmnos="https://bpmnos.telematique.eu" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
          <bpmnos:attribute id="Level" type="integer" name="level := 3" />
          <bpmnos:attribute id="Seen" type="integer" name="seen" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_1" />
    <bpmn2:subProcess id="SubProcess_1">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:startEvent id="StartEvent_2">
        <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_2" sourceRef="StartEvent_2" targetRef="Task_1" />
      <bpmn2:task id="Task_1">
        <bpmn2:extensionElements>
          <bpmnos:status>
            <bpmnos:restrictions>
              <bpmnos:restriction id="Restriction_1" expression="level &gt; 5" />
            </bpmnos:restrictions>
          </bpmnos:status>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_2</bpmn2:incoming>
      </bpmn2:task>
    </bpmn2:subProcess>
    <bpmn2:boundaryEvent id="ErrorBoundaryEvent_All" attachedToRef="SubProcess_1">
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorEventDefinition_2" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="ErrorBoundaryEvent_All" targetRef="EndEvent_All" />
    <bpmn2:endEvent id="EndEvent_All">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:boundaryEvent id="ErrorBoundaryEvent_Other" attachedToRef="SubProcess_1">
      <bpmn2:extensionElements>
        <bpmnos:error name="Other" />
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorEventDefinition_3" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="ErrorBoundaryEvent_Other" targetRef="EndEvent_Other" />
    <bpmn2:endEvent id="EndEvent_Other">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:boundaryEvent id="ErrorBoundaryEvent_Shortage" attachedToRef="SubProcess_1">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_3" expression="seen := Shortage.missing" />
          </bpmnos:operators>
        </bpmnos:status>
        <bpmnos:error name="Shortage" type="{ missing: integer }" />
      </bpmn2:extensionElements>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
      <bpmn2:errorEventDefinition id="ErrorEventDefinition_4" />
    </bpmn2:boundaryEvent>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="ErrorBoundaryEvent_Shortage" targetRef="EndEvent_Shortage" />
    <bpmn2:endEvent id="EndEvent_Shortage">
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
