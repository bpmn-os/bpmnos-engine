<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmnos="https://bpmnos.telematique.eu" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:dataObject id="DataObject_1">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
          <bpmnos:attribute id="Stock" type="integer" name="stock := 0" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="SubProcess_1" />
    <bpmn2:subProcess id="SubProcess_1">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:dataObject id="DataObject_2">
        <bpmn2:extensionElements>
          <bpmnos:attributes>
            <bpmnos:attribute id="Kept" type="integer" name="kept := 3" />
          </bpmnos:attributes>
        </bpmn2:extensionElements>
      </bpmn2:dataObject>
      <bpmn2:startEvent id="StartEvent_2">
        <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:sequenceFlow id="Flow_3" sourceRef="StartEvent_2" targetRef="Task_1" />
      <bpmn2:task id="Task_1">
        <bpmn2:extensionElements>
          <bpmnos:status>
            <bpmnos:operators>
              <bpmnos:operator id="Operator_1" expression="kept := 4" />
            </bpmnos:operators>
          </bpmnos:status>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_3</bpmn2:incoming>
        <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      </bpmn2:task>
      <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_1" targetRef="EndEvent_2" />
      <bpmn2:endEvent id="EndEvent_2">
        <bpmn2:incoming>Flow_4</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:subProcess id="CompensationEventSubProcess_1" triggeredByEvent="true">
        <bpmn2:extensionElements>
          <bpmnos:status>
            <bpmnos:attributes>
              <bpmnos:attribute id="SeenKept" type="integer" name="seen_kept := kept" />
              <bpmnos:attribute id="SeenStock" type="integer" name="seen_stock := stock" />
              <bpmnos:attribute id="Created" type="decimal" name="created := timestamp" />
            </bpmnos:attributes>
          </bpmnos:status>
        </bpmn2:extensionElements>
        <bpmn2:startEvent id="CompensateStartEvent_1">
          <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
          <bpmn2:compensateEventDefinition id="CompensateEventDefinition_1" />
        </bpmn2:startEvent>
        <bpmn2:sequenceFlow id="Flow_5" sourceRef="CompensateStartEvent_1" targetRef="EndEvent_3" />
        <bpmn2:endEvent id="EndEvent_3">
          <bpmn2:incoming>Flow_5</bpmn2:incoming>
        </bpmn2:endEvent>
      </bpmn2:subProcess>
    </bpmn2:subProcess>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="SubProcess_1" targetRef="Activity_2" />
    <bpmn2:task id="Activity_2">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:operators>
            <bpmnos:operator id="Operator_2" expression="stock := 7" />
            <bpmnos:operator id="Operator_3" expression="timestamp += 10" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Activity_2" targetRef="CompensateThrowEvent_1" />
    <bpmn2:endEvent id="CompensateThrowEvent_1">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:compensateEventDefinition id="CompensateEventDefinition_2" />
    </bpmn2:endEvent>
  </bpmn2:process>
</bpmn2:definitions>
